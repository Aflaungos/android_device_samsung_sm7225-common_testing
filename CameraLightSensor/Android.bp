android_app {
    name: "CameraLightSensor",
    srcs: [
        "src/**/*.kt",
        "src/**/I*.aidl",
    ],
    platform_apis: true,
    privileged: true,
    certificate: "platform",
    static_libs: ["androidx.core_core"],
    required: ["privapp_whitelist_com.android.cameralightsensor.xml"],
}

prebuilt_etc {
    name: "privapp_whitelist_com.android.cameralightsensor.xml",
    src: "privapp_whitelist_com.android.cameralightsensor.xml",
    sub_dir: "permissions",
}
